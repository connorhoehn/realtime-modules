  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true,
      "_subpaths": [
        "./server/stores/dynamo"
      ],
      "_note": "The DynamoDB chat stores import the low-level command classes from here; the consumer injects the client (a DynamoDBClient, or a DynamoDBDocumentClient from @aws-sdk/lib-dynamodb, which wraps one)."
    },
    "@connorhoehn/service-runtime": {
      "optional": true,
      "_note": "Required only when using GatewayProxyClient with serviceAuthSecret. The client includes an inlined compatible implementation; install this package when you need server-side verify/require-service-auth utilities.",
      "_range": "Deliberately wide. This peer is not published to the registry — every consumer installs it from a git SHA, currently 0.3.4 — so a narrow range that the installed package does not satisfy sends npm to the registry to look for one, where it 404s and takes the WHOLE install down. That is what `^0.2.0` did to realtime-examples: no npm install could complete there at all, which in turn made it impossible to repin any sibling."
    },
    "@tiptap/extension-collaboration": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ]
    },
    "@tiptap/extension-placeholder": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ]
    },
    "@tiptap/extension-task-item": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ]
    },
    "@tiptap/extension-task-list": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ]
    },
    "@tiptap/react": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ]
    },
    "@tiptap/starter-kit": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ]
    },
    "@tiptap/y-tiptap": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap"
      ],
      "_note": "Loaded lazily by ./client/useCanvasDocument (require-on-use), so importing ./client does NOT need it installed — only calling canvasToDocModel / materialize does. ./adapters/tiptap needs it outright."
    },
    "express": {
      "optional": true,
      "_subpaths": [
        "./server-ws"
      ]
    },
    "react": {
      "optional": true,
      "_subpaths": [
        "./client",
        "./client/ws",
        "./adapters/tiptap",
        "./agent-streaming/client",
        "./client/pipelines",
        "./client/documents"
      ],
      "_note": "./client/ws re-exports GatewaySocketProvider, which is a React component — the subpath is Yjs-free, not React-free."
    },
    "ws": {
      "optional": true,
      "_subpaths": [
        "./server-ws"
      ]
    },
    "y-protocols": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    }
  },
  "devDependencies": {
