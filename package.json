{
  "name": "@connorhoehn/realtime-modules",
  "version": "0.20.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Realtime feature toolkit — UI + backend + manifest triples for chat, presence, CRDT, cursors, agent-streaming, and more.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent-streaming": {
      "types": "./dist/agent-streaming/index.d.ts",
      "default": "./dist/agent-streaming/index.js"
    },
    "./agent-streaming/client": {
      "types": "./dist/agent-streaming/client.d.ts",
      "default": "./dist/agent-streaming/client.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./client/ws": {
      "types": "./dist/client/ws.d.ts",
      "default": "./dist/client/ws.js"
    },
    "./client/video": {
      "types": "./dist/client/video/index.d.ts",
      "default": "./dist/client/video/index.js"
    },
    "./client/hangout-rooms": {
      "types": "./dist/client/hangout-rooms/index.d.ts",
      "import": "./dist/client/hangout-rooms/index.js",
      "default": "./dist/client/hangout-rooms/index.js"
    },
    "./adapters/tiptap": {
      "types": "./dist/adapters/tiptap/index.d.ts",
      "default": "./dist/adapters/tiptap/index.js"
    },
    "./proxy-client": {
      "types": "./dist/proxy-client/index.d.ts",
      "default": "./dist/proxy-client/index.js"
    },
    "./server-ws": {
      "types": "./dist/server-ws/index.d.ts",
      "default": "./dist/server-ws/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "default": "./dist/chat/index.js"
    },
    "./presence": {
      "types": "./dist/presence/index.d.ts",
      "default": "./dist/presence/index.js"
    },
    "./activity": {
      "types": "./dist/activity/index.d.ts",
      "default": "./dist/activity/index.js"
    },
    "./cursor": {
      "types": "./dist/cursor/index.d.ts",
      "default": "./dist/cursor/index.js"
    },
    "./ingest": {
      "types": "./dist/ingest/index.d.ts",
      "default": "./dist/ingest/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "default": "./dist/pipeline/index.js"
    },
    "./reactions": {
      "types": "./dist/reactions/index.d.ts",
      "default": "./dist/reactions/index.js"
    },
    "./social": {
      "types": "./dist/social/index.d.ts",
      "default": "./dist/social/index.js"
    },
    "./call": {
      "types": "./dist/call/index.d.ts",
      "default": "./dist/call/index.js"
    },
    "./room": {
      "types": "./dist/room/index.d.ts",
      "default": "./dist/room/index.js"
    },
    "./notification": {
      "types": "./dist/notification/index.d.ts",
      "default": "./dist/notification/index.js"
    },
    "./fileupload": {
      "types": "./dist/fileupload/index.d.ts",
      "default": "./dist/fileupload/index.js"
    },
    "./typed-documents": {
      "types": "./dist/typed-documents/index.d.ts",
      "default": "./dist/typed-documents/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run verify:exports",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:contract": "tsc -p tsconfig.contract.json",
    "prepare": "test -f dist/index.js || npm run build",
    "prepublishOnly": "npm run build && npm test",
    "demo": "cd demo && npm run dev",
    "demo:build": "cd demo && npm run build",
    "clean": "rm -rf dist",
    "verify:exports": "node scripts/verify-exports.mjs",
    "smoke:features": "node scripts/smoke-features.mjs"
  },
  "dependencies": {
    "distributed-core": "github:connorhoehn/distributed-core#b6f38f57b781a8bf74ff9e31a35b6062f7193dc9",
    "lru-cache": "^10.4.3",
    "yjs": "^13.0.0"
  },
  "peerDependencies": {
    "@connorhoehn/service-runtime": "^0.2.0",
    "@tiptap/extension-collaboration": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/y-tiptap": "^3.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "ws": "^8.0.0",
    "y-protocols": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@connorhoehn/service-runtime": {
      "optional": true,
      "_note": "Required only when using GatewayProxyClient with serviceAuthSecret. The client includes an inlined compatible implementation; install this package when you need server-side verify/require-service-auth utilities."
    },
    "@tiptap/extension-collaboration": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "@tiptap/extension-placeholder": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "@tiptap/extension-task-item": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "@tiptap/extension-task-list": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "@tiptap/react": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "@tiptap/starter-kit": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "@tiptap/y-tiptap": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    },
    "express": {
      "optional": true,
      "_subpaths": [
        "./server-ws"
      ]
    },
    "react": {
      "optional": true,
      "_subpaths": [
        "./client",
        "./adapters/tiptap",
        "./agent-streaming/client"
      ]
    },
    "ws": {
      "optional": true,
      "_subpaths": [
        "./server-ws"
      ]
    },
    "y-protocols": {
      "optional": true,
      "_subpaths": [
        "./adapters/tiptap",
        "./client"
      ]
    }
  },
  "devDependencies": {
    "@connorhoehn/event-catalog": "github:connorhoehnslalom/event-catalog#474ed44e6df286e92abaaeb705fcd79e871178b5",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extension-collaboration": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-task-item": "^3.22.3",
    "@tiptap/extension-task-list": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@tiptap/y-tiptap": "^3.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "express": "^4.22.2",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "~5.6.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  }
}
