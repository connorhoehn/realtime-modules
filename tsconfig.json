{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "distributed-core/transport": ["node_modules/distributed-core/dist/transport/index.d.ts"],
      "distributed-core/applications/document": ["node_modules/distributed-core/dist/applications/document/index.d.ts"],
      "@connorhoehn/event-catalog/client-frames": ["node_modules/@connorhoehn/event-catalog/dist/generated/client-frames.d.ts"],
      "@connorhoehn/event-catalog/types": ["node_modules/@connorhoehn/event-catalog/dist/generated/event-types.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
